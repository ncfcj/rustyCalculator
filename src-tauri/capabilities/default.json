{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window — only calculator commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-display",
    "allow-input-digit",
    "allow-input-decimal",
    "allow-set-operation",
    "allow-evaluate",
    "allow-clear-all",
    "allow-backspace",
    "allow-toggle-sign"
  ]
}
